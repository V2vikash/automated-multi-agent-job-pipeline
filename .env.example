# Application Settings
APP_NAME=Job Intelligence Platform
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-secret-key-32-chars-min

# Server Config
HOST=0.0.0.0
PORT=8000

# Security / CORS (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_intelligence_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/job_intelligence_db

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=job-intelligence-platform

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000
